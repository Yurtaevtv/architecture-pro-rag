# .env
# Настройки моделей
RAGBOT_MODEL_PATH=huihui-ai/Huihui-Qwen3.5-2B-abliterated
EMBEDDING_MODEL=LaBSE
CACHE_DIR=./models

# Настройки устройства
DEVICE=mps  # cuda, cpu, mps для Mac
USE_8BIT=true  # для экономии памяти

# Настройки векторной базы
VECTOR_STORE_TYPE=chroma  # chroma или faiss
CHROMA_HOST=localhost
CHROMA_PORT=8000
COLLECTION_NAME=documents

# Параметры RAG
TOP_K=5
MAX_LENGTH=2048
TEMPERATURE=0.1
TOP_P=0.9
MAX_NEW_TOKENS=2000
CHUNK_SIZE=3000